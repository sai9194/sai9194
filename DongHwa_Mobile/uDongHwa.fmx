    SQLInsert.Strings = (
      'Select Count(C.ControllerID) as C from Alarm  as A with(NOLOCK)'
      'Inner Join ControllerInfo as C with(NOLOCK)'
      'On A.ControllerID = C.ControllerID'
      'Where C.MasterID = :MasterID'
      'AND A.Dcheck = '#39'N'#39' ')

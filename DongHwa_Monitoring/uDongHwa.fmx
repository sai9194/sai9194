  object UniQueryTempCheck: TUniQuery
    SQLInsert.Strings = (
      'SELECT '
      '    T.CheckDate,'
      '    T.Temp,'
      '    T.SetTemp,'
      '    C.ControllerID,'
      '    C.ControllerName,'
      '    C.Serial,'
      '    CONVERT(CHAR(10), C.WritingDateTime, 23) AS WDT,'
      '    ISNULL(C.Alarm, 1) AS Alarm,'
      '    Mo.Name AS ControllerModel,'
      '    Mo.InCount,'
      '    Mo.OutCount,'
      '    T.PowerState,'
      '    T.Err,'
      '    COALESCE(C.TempName, '#39#54788#51116#50728#46020#39') AS TempName,'
      '    COALESCE(C.SetTempName, '#39#49444#51221#50728#46020#39') AS SetTempName,'
      '    COALESCE(C.In1, '#39'1'#39') AS In1,'
      '    COALESCE(C.In2, '#39'2'#39') AS In2,'
      '    COALESCE(C.In3, '#39'3'#39') AS In3,'
      '    COALESCE(C.In4, '#39'4'#39') AS In4,'
      '    COALESCE(C.In5, '#39'5'#39') AS In5,'
      '    COALESCE(C.Out1, Mo.K1Name) AS Out1,'
      '    COALESCE(C.Out2, Mo.K2Name) AS Out2,'
      '    COALESCE(C.Out3, Mo.K3Name) AS Out3,'
      '    COALESCE(C.Out4, Mo.K4Name) AS Out4,'
      '    COALESCE(C.Out5, Mo.K5Name) AS Out5,'
      '    COALESCE(C.HighTemp, 50) AS HighTemp,'
      '    COALESCE(C.LowTemp, -10) AS LowTemp,'
      '    ISNULL(T.DIn1, 0) AS DIn1,'
      '    ISNULL(T.DIn2, 0) AS DIn2,'
      '    ISNULL(T.DIn3, 0) AS DIn3,'
      '    ISNULL(T.DIn4, 0) AS DIn4,'
      '    ISNULL(T.DIn5, 0) AS DIn5,'
      '    ISNULL(T.DOut1, 0) AS DOut1,'
      '    ISNULL(T.DOut2, 0) AS DOut2,'
      '    ISNULL(T.DOut3, 0) AS DOut3,'
      '    ISNULL(T.DOut4, 0) AS DOut4,'
      '    ISNULL(T.DOut5, 0) AS DOut5,'
      '    Mo.K1Color2,'
      '    Mo.K2Color2,'
      '    Mo.K3Color2,'
      '    Mo.K4Color2,'
      '    Mo.K5Color2,'
      '    Mo.K1Index,'
      '    Mo.K2Index,'
      '    Mo.K3Index,'
      '    Mo.K4Index,'
      '    Mo.K5Index,'
      '    T.DefrostMode,'
      '    T.DefrostState,'
      '    T.occur_time'
      'FROM TempState AS T  WITH(NOLOCK) '
      
        'INNER JOIN ControllerInfo AS C  WITH(NOLOCK)  ON C.SerialNo = T.' +
        'SerialNo'
      'LEFT JOIN Model AS Mo  WITH(NOLOCK)  ON Mo.Code = C.ModelCode'
      'WHERE C.MasterID = :MasterID'
      'ORDER BY C.ModifiedDateTime'
      'OFFSET (:PAGE - 1) * :PAGE_SIZE ROWS'
      'FETCH NEXT :PAGE_SIZE ROWS ONLY;')
    Connection = UniConnection1
    Left = 136
    Top = 456
  end

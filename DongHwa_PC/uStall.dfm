  object UniQuery_Stall_S: TUniQuery
    Connection = fDongHwa.UniConnection1
    SQL.Strings = (
      'select '
      #9'M.LoginID'
      #9',M.Name'
      #9',C.ControllerName'
      #9',A.[Serial]'
      
        #9',CASE WHEN ISNULL(A.SerialNo,'#39#39') = '#39#39' THEN c.SerialNo ELSE A.Se' +
        'rialNo END AS SerialNo'
      '    ,A.[lsindRegistNo]'
      '    ,A.[itemCode]'
      '    ,A.[makrId]'
      '    ,A.[eqpmnCode]'
      '    ,A.[eqpmnEsntlSn]'
      '    ,A.[eqpmnNo]'
      '    ,A.[stallTyCode]'
      '    ,A.[stallNo]'
      '    ,A.[roomNo]'
      '    ,A.[roomDtlNo]'
      '    ,ISNULL(A.[Linkcycle],0) AS [Linkcycle]'
      '    ,A.[LinkcycleType]'
      '    ,A.[WDT]'
      'from('
      'SELECT [Serial]'
      #9'  ,SerialNo'
      '      ,[lsindRegistNo]'
      '      ,[itemCode]'
      '      ,[makrId]'
      '      ,[eqpmnCode]'
      '      ,[eqpmnEsntlSn]'
      '      ,[eqpmnNo]'
      '      ,[stallTyCode]'
      '      ,[stallNo]'
      '      ,[roomNo]'
      '      ,[roomDtlNo]'
      '      ,ISNULL([Linkcycle],0) AS [Linkcycle]'
      '      ,[LinkcycleType]'
      '      ,[WDT]'
      '  FROM [dbo].[stall_Info]'
      '  WHERE [Serial] = :Serial'
      '  )as A'
      ' left join ControllerInfo as C On C.Serial   = A.Serial'
      ' left join MasterUser'#9'  as M On C.MasterID = M.UserID'
      'ORDER BY [WDT] DESC'
      '')
    Left = 488
    Top = 27
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'Serial'
        Value = nil
      end>
  end
